# --- OpenClaw Agent ---
MAPLE_OPENCLAW_AGENT_ENABLED=false
MAPLE_OPENCLAW_AGENT_MODE=local
MAPLE_OPENCLAW_AGENT_REQUIRED=false
MAPLE_OPENCLAW_AGENT_DEV_PROFILE=false
