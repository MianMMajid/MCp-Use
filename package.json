{
  "name": "maple",
  "type": "module",
  "version": "1.0.0",
  "description": "MCP server: maple",
  "author": "",
  "license": "MIT",
  "keywords": [
    "mcp",
    "server",
    "starter",
    "tools",
    "resources",
    "prompts",
    "uiresource",
    "ui",
    "react",
    "widgets",
    "mcp-ui",
    "apps-sdk"
  ],
  "main": "backend/backendB-core-services/gateway-api/service/dist/main.js",
  "scripts": {
    "build": "npm run mesh:build",
    "dev": "bash backend/backendA-platform-infra/scripts/dev-fast.sh",
    "start": "bash backend/backendA-platform-infra/scripts/dev-fast.sh",
    "dev:fast": "bash backend/backendA-platform-infra/scripts/dev-fast.sh",
    "dev:fast:openclaw": "DEV_FAST_OPENCLAW=1 bash backend/backendA-platform-infra/scripts/dev-fast.sh",
    "dev:k8s": "bash backend/backendA-platform-infra/scripts/k8s-local-all.sh",
    "validate:k8s": "bash scripts/run-k8s-validation.sh",
    "gate:k8s": "bash scripts/run-k8s-release-gate.sh",
    "preflight": "node backend/backendA-platform-infra/scripts/preflight.mjs --mode=run",
    "preflight:strict": "node backend/backendA-platform-infra/scripts/preflight.mjs --strict --mode=run",
    "preflight:deploy": "MAPLE_PREFLIGHT_CHECK_REACHABILITY=1 node backend/backendA-platform-infra/scripts/preflight.mjs --strict --mode=deploy",
    "sync:runtime-assets": "bash backend/backendA-platform-infra/scripts/sync-runtime-assets.sh",
    "mesh:bootstrap:src": "node backend/backendA-platform-infra/scripts/bootstrap-service-sources.mjs",
    "mesh:build": "node backend/backendA-platform-infra/scripts/build-core-services.mjs",
    "contracts:check": "node backend/backendA-platform-infra/scripts/check-proto-sync.mjs",
    "contracts:generate": "node backend/backendA-platform-infra/scripts/generate-contract-protos.mjs",
    "prebuild": "npm run sync:runtime-assets",
    "predev": "echo \"predev handled by backend/backendA-platform-infra/scripts/dev-fast.sh\"",
    "prestart": "echo \"prestart handled by backend/backendA-platform-infra/scripts/dev-fast.sh\"",
    "predeploy": "npm run preflight:deploy && npm run sync:runtime-assets && npm run mesh:build",
    "branch-protection:check": "node backend/backendA-platform-infra/scripts/check-branch-protection.mjs --branch=main --required-checks=backend-checks,frontend-tests,k8s-release-gate",
    "local:down": "bash backend/backendA-platform-infra/scripts/local-down.sh",
    "test:frontend:setup": "npx playwright install chromium",
    "test:frontend:setup:ci": "npx playwright install --with-deps chromium",
    "test:frontend:unit": "vitest run --config tests/frontend/vitest.config.ts",
    "test:frontend:coverage": "vitest run --coverage --config tests/frontend/vitest.config.ts",
    "test:frontend:e2e": "playwright test --config tests/frontend/playwright.config.ts",
    "test:frontend:flow": "node tests/frontend/scripts/run-flow.mjs",
    "test:frontend:flow:ci": "node tests/frontend/scripts/run-flow.mjs --ci",
    "check:source-backed-packages": "bash scripts/check-source-backed-packages.sh",
    "check:no-legacy-modifier-endpoints": "bash scripts/check-no-legacy-modifier-endpoints.sh",
    "check:repo-hygiene": "bash scripts/check-repo-hygiene.sh",
    "check:lockfile-policy": "bash scripts/check-lockfile-policy.sh",
    "check:deprecated-command-aliases": "node scripts/check-deprecated-command-aliases.mjs",
    "check:command-surface": "node scripts/check-command-surface.mjs",
    "service:audit:inventory": "node scripts/service-inventory.mjs",
    "service:audit:callgraph": "node scripts/service-callgraph-static.mjs",
    "service:audit:report": "node scripts/build-service-utilization-report.mjs",
    "check:service-topology-parity": "node scripts/check-service-topology-parity.mjs",
    "check:service-route-coverage": "node scripts/check-active-route-to-service-coverage.mjs",
    "check:service-necessity": "node scripts/check-service-necessity-thresholds.mjs",
    "check:service-utilization": "node scripts/check-service-utilization-thresholds.mjs",
    "check:frontendB:surface": "npm --prefix frontend/frontendB-desktop-app/template-runtime run check:surface",
    "test:matrix": "bash scripts/run-full-matrix.sh",
    "test": "npm run test:mesh-services && npm run test:saas-services && npm run test:infra-scripts",
    "test:mesh-services": "NODE_ENV=test MAPLE_LOG_LEVEL=error MAPLE_LOG_REQUESTS=0 MAPLE_LOG_INCLUDE_BODIES=0 MAPLE_LOG_BODY_MAX_CHARS=4000 MAPLE_FIREWALL_LOG_DIR=~/.maple/firewall-logs node scripts/run-mesh-service-tests.mjs",
    "test:retired-services": "NODE_ENV=test MAPLE_LOG_LEVEL=error MAPLE_LOG_REQUESTS=0 MAPLE_LOG_INCLUDE_BODIES=0 MAPLE_LOG_BODY_MAX_CHARS=4000 MAPLE_FIREWALL_LOG_DIR=~/.maple/firewall-logs node scripts/run-retired-service-tests.mjs",
    "test:saas-services": "NODE_ENV=test MAPLE_LOG_LEVEL=error MAPLE_LOG_REQUESTS=0 MAPLE_LOG_INCLUDE_BODIES=0 MAPLE_LOG_BODY_MAX_CHARS=4000 MAPLE_FIREWALL_LOG_DIR=~/.maple/firewall-logs node --test backend/backendC-saas-services/*/service/tests/*.test.mjs",
    "test:infra-scripts": "NODE_ENV=test MAPLE_LOG_LEVEL=error MAPLE_LOG_REQUESTS=0 MAPLE_LOG_INCLUDE_BODIES=0 MAPLE_LOG_BODY_MAX_CHARS=4000 MAPLE_FIREWALL_LOG_DIR=~/.maple/firewall-logs node --test backend/backendA-platform-infra/tests/*.test.mjs",
    "test:providers-live": "bash -lc 'set -a; [ -f .env ] && source .env; set +a; NODE_ENV=test MAPLE_LIVE_PROVIDER_E2E=1 node --test backend/backendA-platform-infra/tests/live-provider-e2e.test.mjs'",
    "test:providers-live:matrix": "bash -lc 'set -a; [ -f .env ] && source .env; set +a; MAPLE_LIVE_GATEWAY_URL=\"${MAPLE_LIVE_GATEWAY_URL:-http://127.0.0.1:3000}\" NODE_ENV=test MAPLE_LIVE_DEP_MATRIX_E2E=1 node --test backend/backendA-platform-infra/tests/live-dependency-matrix-e2e.test.mjs'",
    "typecheck": "node backend/backendA-platform-infra/scripts/check-service-sources.mjs && node backend/backendA-platform-infra/scripts/check-proto-sync.mjs",
    "northflank:template": "node backend/backendA-platform-infra/deploy/northflank/render-template.mjs",
    "northflank:tls": "bash backend/backendA-platform-infra/deploy/northflank/generate-northflank-tls.sh",
    "northflank:args": "node backend/backendA-platform-infra/deploy/northflank/generate-args.mjs",
    "northflank:oneclick": "node backend/backendA-platform-infra/deploy/northflank/prepare-oneclick.mjs",
    "postinstall": "echo \"Skipping postinstall type generation\"",
    "check:frontend-warning-budget": "node scripts/check-frontend-warning-budget.mjs --log artifacts/matrix/frontend-flow.log"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0",
    "@maple/common": "file:backend/backendB-core-services/shared/packages/maple-common",
    "@maple/persistence": "file:backend/backendB-core-services/shared/packages/maple-persistence",
    "@maple/proto-ts": "file:backend/backendB-core-services/shared/packages/maple-proto-ts",
    "@maple/risk-engine": "file:backend/backendB-core-services/shared/packages/maple-risk-engine",
    "@maple/security": "file:backend/backendB-core-services/shared/packages/maple-security",
    "@maple/types": "file:backend/backendB-core-services/shared/packages/maple-types",
    "@openai/apps-sdk-ui": "^0.2.1",
    "@tanstack/react-query": "^5.90.12",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "mcp-use": "1.20.0",
    "node-mocks-http": "^1.17.2",
    "pg": "^8.19.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0",
    "stripe": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "msw": "^2.11.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sugarss": "^5.0.1",
    "lodash": "4.17.23"
  }
}
