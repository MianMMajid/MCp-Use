{
  "name": "maple-firewall",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Multi-service MCP firewall architecture",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "proto:gen": "buf generate",
    "proto:lint": "buf lint",
    "build": "npm run proto:gen && npm run build:packages && npm run build:services",
    "build:packages": "npm run build -w @maple/types -w @maple/proto && npm run build -w @maple/common -w @maple/security -w @maple/risk-engine -w @maple/persistence",
    "build:services": "npm run build -w @maple/audit-writer -w @maple/context-wall -w @maple/model-router -w @maple/secrets-broker -w @maple/tool-runner -w @maple/mcp-proxy -w @maple/cyber-proxy -w @maple/gateway-api -w @maple/admin-console",
    "dev": "docker compose up --build",
    "test": "npm -ws --if-present run test",
    "lint": "npm -ws --if-present run lint",
    "clean": "npm -ws --if-present run clean"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.65.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "typescript": "^5.9.3"
  }
}
