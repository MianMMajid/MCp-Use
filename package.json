{
  "name": "maple",
  "type": "module",
  "version": "1.0.0",
  "description": "MCP server: maple",
  "author": "",
  "license": "MIT",
  "keywords": [
    "mcp",
    "server",
    "starter",
    "tools",
    "resources",
    "prompts",
    "uiresource",
    "ui",
    "react",
    "widgets",
    "mcp-ui",
    "apps-sdk"
  ],
  "main": "backend/backendB-core-services/gateway-api/service/dist/main.js",
  "scripts": {
    "build": "npm run mesh:build",
    "dev": "bash backend/backendA-platform-infra/scripts/k8s-local-all.sh",
    "start": "bash backend/backendA-platform-infra/scripts/k8s-local-all.sh",
    "preflight": "node backend/backendA-platform-infra/scripts/preflight.mjs --mode=run",
    "preflight:strict": "node backend/backendA-platform-infra/scripts/preflight.mjs --strict --mode=run",
    "preflight:deploy": "MAPLE_PREFLIGHT_CHECK_REACHABILITY=1 node backend/backendA-platform-infra/scripts/preflight.mjs --strict --mode=deploy",
    "sync:runtime-assets": "bash backend/backendA-platform-infra/scripts/sync-runtime-assets.sh",
    "mesh:bootstrap:src": "node backend/backendA-platform-infra/scripts/bootstrap-service-sources.mjs",
    "mesh:build": "node backend/backendA-platform-infra/scripts/build-core-services.mjs",
    "contracts:check": "node backend/backendA-platform-infra/scripts/check-proto-sync.mjs",
    "prebuild": "npm run sync:runtime-assets",
    "predev": "npm run preflight && npm run sync:runtime-assets && npm run mesh:build",
    "prestart": "npm run preflight && npm run sync:runtime-assets && npm run mesh:build",
    "predeploy": "npm run preflight:deploy && npm run sync:runtime-assets && npm run mesh:build",
    "dev:frontendA": "bash backend/backendA-platform-infra/scripts/dev-surface.sh frontendA",
    "dev:frontendB": "bash backend/backendA-platform-infra/scripts/dev-surface.sh frontendB",
    "dev:frontendC": "bash backend/backendA-platform-infra/scripts/dev-surface.sh frontendC",
    "dev:frontendD": "bash backend/backendA-platform-infra/scripts/dev-surface.sh frontendD",
    "dev:widgets": "bash backend/backendA-platform-infra/scripts/dev-surface.sh frontendD",
    "contracts:generate": "node backend/backendA-platform-infra/scripts/generate-contract-protos.mjs",
    "branch-protection:check": "node backend/backendA-platform-infra/scripts/check-branch-protection.mjs --branch=main --required-check=backend-checks",
    "desktop:install": "cd frontend/frontendB-desktop-app && npm install",
    "desktop:dev": "cd frontend/frontendB-desktop-app && npm run dev",
    "desktop:dist": "cd frontend/frontendB-desktop-app && npm run dist --",
    "desktop:dist:mac": "cd frontend/frontendB-desktop-app && npm run dist:mac --",
    "desktop:dist:win": "cd frontend/frontendB-desktop-app && npm run dist:win --",
    "desktop:dist:linux": "cd frontend/frontendB-desktop-app && npm run dist:linux --",
    "test:frontend:setup": "npx playwright install chromium",
    "test:frontend:setup:ci": "npx playwright install --with-deps chromium",
    "test:frontend:unit": "vitest run --config tests/frontend/vitest.config.ts",
    "test:frontend:unit:watch": "vitest --config tests/frontend/vitest.config.ts",
    "test:frontend:coverage": "vitest run --coverage --config tests/frontend/vitest.config.ts",
    "test:frontend:e2e": "playwright test --config tests/frontend/playwright.config.ts",
    "test:frontend:flow": "node tests/frontend/scripts/run-flow.mjs",
    "test:frontend:flow:quick": "node tests/frontend/scripts/run-flow.mjs --quick",
    "test:frontend:flow:ci": "node tests/frontend/scripts/run-flow.mjs --ci",
    "test": "npm run test:mesh-services && npm run test:saas-services && npm run test:infra-scripts",
    "test:mesh-services": "NODE_ENV=test DATABASE_URL=postgresql://maple:maple@127.0.0.1:5432/maple_test MAPLE_LOG_LEVEL=error MAPLE_LOG_REQUESTS=0 node --test backend/backendB-core-services/*/service/tests/*.test.mjs",
    "test:saas-services": "NODE_ENV=test DATABASE_URL=postgresql://maple:maple@127.0.0.1:5432/maple_test MAPLE_LOG_LEVEL=error MAPLE_LOG_REQUESTS=0 node --test backend/backendC-saas-services/*/service/tests/*.test.mjs",
    "test:infra-scripts": "NODE_ENV=test DATABASE_URL=postgresql://maple:maple@127.0.0.1:5432/maple_test MAPLE_LOG_LEVEL=error MAPLE_LOG_REQUESTS=0 node --test backend/backendA-platform-infra/tests/*.test.mjs",
    "test:providers-live": "NODE_ENV=test MAPLE_LIVE_PROVIDER_E2E=1 node --test backend/backendA-platform-infra/tests/live-provider-e2e.test.mjs",
    "typecheck": "npm run typecheck:mesh && npm run typecheck:saas",
    "typecheck:mesh": "node backend/backendA-platform-infra/scripts/check-service-sources.mjs && node backend/backendA-platform-infra/scripts/check-proto-sync.mjs",
    "typecheck:saas": "npx tsc --noEmit --project backend/backendC-saas-services/business-api/service/tsconfig.json",
    "test:backend-smoke": "bash backend/backendA-platform-infra/scripts/smoke-core-services.sh",
    "deploy": "bash backend/backendA-platform-infra/scripts/k8s-local-up.sh",
    "northflank:template": "node backend/backendA-platform-infra/deploy/northflank/render-template.mjs",
    "northflank:tls": "bash backend/backendA-platform-infra/deploy/northflank/generate-northflank-tls.sh",
    "northflank:args": "node backend/backendA-platform-infra/deploy/northflank/generate-args.mjs",
    "northflank:oneclick": "node backend/backendA-platform-infra/deploy/northflank/prepare-oneclick.mjs",
    "demo:install-openclaw": "bash backend/backendA-platform-infra/scripts/install-openclaw.sh",
    "demo:bridge": "node backend/backendA-platform-infra/scripts/openclaw-bridge-hardcoded.mjs",
    "demo:up": "bash backend/backendA-platform-infra/scripts/demo-up.sh",
    "demo:down": "bash backend/backendA-platform-infra/scripts/demo-down.sh",
    "demo:run": "node backend/backendA-platform-infra/scripts/demo-generator.mjs",
    "trace:demo": "node backend/backendA-platform-infra/scripts/agent-trace-demo.mjs",
    "hackathon:up": "bash backend/backendA-platform-infra/scripts/hackathon-start.sh",
    "hackathon:down": "bash backend/backendA-platform-infra/scripts/hackathon-down.sh",
    "hackathon:verify": "bash backend/backendA-platform-infra/scripts/hackathon-verify.sh",
    "local:up": "bash backend/backendA-platform-infra/scripts/local-up.sh",
    "local:down": "bash backend/backendA-platform-infra/scripts/local-down.sh",
    "k8s:up": "bash backend/backendA-platform-infra/scripts/k8s-local-up.sh",
    "k8s:dev": "bash backend/backendA-platform-infra/scripts/k8s-local-dev.sh",
    "k8s:all": "bash backend/backendA-platform-infra/scripts/k8s-local-all.sh",
    "k8s:certs": "bash backend/backendA-platform-infra/scripts/generate-local-certs.sh",
    "k8s:down": "bash backend/backendA-platform-infra/scripts/k8s-local-down.sh",
    "k8s:status": "bash backend/backendA-platform-infra/scripts/k8s-local-status.sh",
    "k8s:pf": "bash backend/backendA-platform-infra/scripts/k8s-local-port-forward.sh",
    "k8s:logs": "bash backend/backendA-platform-infra/scripts/k8s-logs-aggregate.sh",
    "postinstall": "echo \"Skipping postinstall type generation\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0",
    "@maple/common": "file:backend/backendB-core-services/shared/packages/maple-common",
    "@maple/persistence": "file:backend/backendB-core-services/shared/packages/maple-persistence",
    "@maple/proto-ts": "file:backend/backendB-core-services/shared/packages/maple-proto-ts",
    "@maple/risk-engine": "file:backend/backendB-core-services/shared/packages/maple-risk-engine",
    "@maple/security": "file:backend/backendB-core-services/shared/packages/maple-security",
    "@maple/types": "file:backend/backendB-core-services/shared/packages/maple-types",
    "@openai/apps-sdk-ui": "^0.2.1",
    "@tanstack/react-query": "^5.90.12",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mcp-use": "1.20.0",
    "node-mocks-http": "^1.17.2",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0",
    "stripe": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/node": "^25.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^26.1.0",
    "msw": "^2.11.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vite": "^7.3.0"
  },
  "overrides": {
    "sugarss": "^5.0.1",
    "lodash": "4.17.23"
  }
}
