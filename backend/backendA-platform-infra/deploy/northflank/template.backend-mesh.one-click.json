{
  "apiVersion": "v1.2",
  "arguments": {
    "projectName": "maple-mesh",
    "projectDescription": "Maple full stack on Northflank",
    "projectColor": "#0f172a",
    "projectRegion": "us-east",
    "repoUrl": "https://github.com/MianMMajid/MCp-Use",
    "repoProvider": "github",
    "repoBranch": "main",
    "deploymentPlan": "nf-compute-20",
    "buildPlan": "nf-compute-200-8",
    "postgresDeploymentPlan": "nf-compute-20",
    "postgresStorageMb": 10240,
    "postgresReplicas": 1,
    "runtimeStrictDependencies": "0",
    "enforceStartupDependencies": "0",
    "corsOrigin": "*",
    "mapleApiKey": "maple-dev-key-12345678901234567890",
    "mapleApiKeys": "",
    "mapleAdminPassword": "maple-live-2026",
    "mapleAdminApiKey": "",
    "mapleAdminApiKeys": "",
    "openclawBridgeToken": "dev-bridge-token",
    "openclawGatewayToken": "",
    "openclawGatewaySessionKey": "agent-dev-main",
    "openclawAgentRequired": "0",
    "googleClientId": "759781457068-f3evko5khalsheda4fh2aivhrq4kure6.apps.googleusercontent.com",
    "stripeSecretKey": "sk_test_51T4x2m9axduMRCAQuioQclAAwRmM2w0JXwyBoDWPMbcCC1P6gLhCYAmNLTmhHEc2QUB1WrYfYiWkdxXNWxu067AO00lH2V2036",
    "stripeWebhookSecret": "whsec_g1OoaBjS3Hc7Qoo5EKWAMASCMWHBLgUj",
    "stripePricePro": "price_1T4xEH9axduMRCAQWcGsFuI2",
    "stripePriceTeam": "price_1T4xEb9axduMRCAQ6bq4YABd",
    "stripePriceEnterprise": "price_1T4xEt9axduMRCAQIF5XOWxw",
    "stripePublishableKey": "pk_test_51T4x2m9axduMRCAQYZowjyUMbdR1CLSUNfJwT5wYWh7DRSZDnaF2fqDB2VEBIxDIJfqIpqwxCSxweqo82uML2b8H00rOl4nYVN",
    "openaiApiKey": "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",
    "anthropicApiKey": "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",
    "sendgridApiKey": "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",
    "resendApiKey": "",
    "twilioAccountSid": "",
    "twilioAuthToken": "",
    "recoveryEmailProvider": "none",
    "recoveryEmailFrom": "",
    "recoverySmsProvider": "none",
    "recoverySmsFrom": "",
    "recoverySmsTo": "",
    "recoveryDeliveryRequired": "0",
    "tlsCertBase64": "",
    "tlsKeyBase64": "",
    "tlsCaBase64": ""
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "ref": "project",
          "kind": "Project",
          "spec": {
            "name": "${args.projectName}",
            "description": "${args.projectDescription}",
            "color": "${args.projectColor}",
            "region": "${args.projectRegion}"
          }
        },
        {
          "ref": "postgres",
          "kind": "Addon",
          "spec": {
            "name": "maple-postgres",
            "projectId": "${refs.project.id}",
            "type": "postgresql",
            "version": "16",
            "billing": {
              "deploymentPlan": "${args.postgresDeploymentPlan}",
              "storage": "${args.postgresStorageMb}",
              "replicas": "${args.postgresReplicas}"
            },
            "tlsEnabled": true
          }
        },
        {
          "kind": "SecretGroup",
          "spec": {
            "name": "maple-runtime-env",
            "projectId": "${refs.project.id}",
            "type": "secret",
            "secretType": "environment",
            "priority": 50,
            "secrets": {
              "variables": {
                "NODE_ENV": "production",
                "CORS_ORIGIN": "${args.corsOrigin}",
                "MAPLE_RUNTIME_STRICT_DEPENDENCIES": "${args.runtimeStrictDependencies}",
                "MAPLE_ENFORCE_STARTUP_DEPENDENCIES": "${args.enforceStartupDependencies}",
                "MAPLE_ALLOW_NO_AUTH": "0",
                "MAPLE_GRPC_TLS_CERT": "/etc/maple/tls/tls.crt",
                "MAPLE_GRPC_TLS_KEY": "/etc/maple/tls/tls.key",
                "MAPLE_GRPC_TLS_CA": "/etc/maple/tls/ca.crt",
                "MAPLE_GATEWAY_TLS_CERT": "/etc/maple/tls/tls.crt",
                "MAPLE_GATEWAY_TLS_KEY": "/etc/maple/tls/tls.key",
                "MAPLE_GATEWAY_TLS_CA": "/etc/maple/tls/ca.crt",
                "CONTEXT_WALL_ADDRESS": "context-wall:9000",
                "MCP_PROXY_ADDRESS": "mcp-proxy:9200",
                "CYBER_PROXY_ADDRESS": "cyber-proxy:8080",
                "AUDIT_WRITER_ADDRESS": "audit-writer:9400",
                "OPENCLAW_BRIDGE_MODE": "gateway",
                "OPENCLAW_BRIDGE_URL": "http://openclaw-bridge:8787",
                "OPENCLAW_BRIDGE_TOKEN": "${args.openclawBridgeToken}",
                "OPENCLAW_GATEWAY_WS_URL": "ws://openclaw-gateway:19001",
                "OPENCLAW_GATEWAY_TOKEN": "${args.openclawGatewayToken}",
                "OPENCLAW_GATEWAY_SESSION_KEY": "${args.openclawGatewaySessionKey}",
                "MAPLE_OPENCLAW_AGENT_MODE": "gateway",
                "MAPLE_OPENCLAW_AGENT_REQUIRED": "${args.openclawAgentRequired}",
                "MAPLE_OPENCLAW_AGENT_AUTOSTART_GATEWAY": "0",
                "MAPLE_API_KEY": "${args.mapleApiKey}",
                "MAPLE_API_KEYS": "${args.mapleApiKeys}",
                "MAPLE_ADMIN_PASSWORD": "${args.mapleAdminPassword}",
                "MAPLE_ADMIN_API_KEY": "${args.mapleAdminApiKey}",
                "MAPLE_ADMIN_API_KEYS": "${args.mapleAdminApiKeys}",
                "GOOGLE_CLIENT_ID": "${args.googleClientId}",
                "STRIPE_SECRET_KEY": "${args.stripeSecretKey}",
                "STRIPE_WEBHOOK_SECRET": "${args.stripeWebhookSecret}",
                "STRIPE_PRICE_PRO": "${args.stripePricePro}",
                "STRIPE_PRICE_TEAM": "${args.stripePriceTeam}",
                "STRIPE_PRICE_ENTERPRISE": "${args.stripePriceEnterprise}",
                "STRIPE_PUBLISHABLE_KEY": "${args.stripePublishableKey}",
                "OPENAI_API_KEY": "${args.openaiApiKey}",
                "ANTHROPIC_API_KEY": "${args.anthropicApiKey}",
                "SENDGRID_API_KEY": "${args.sendgridApiKey}",
                "RESEND_API_KEY": "${args.resendApiKey}",
                "TWILIO_ACCOUNT_SID": "${args.twilioAccountSid}",
                "TWILIO_AUTH_TOKEN": "${args.twilioAuthToken}",
                "MAPLE_RECOVERY_EMAIL_PROVIDER": "${args.recoveryEmailProvider}",
                "MAPLE_RECOVERY_EMAIL_FROM": "${args.recoveryEmailFrom}",
                "MAPLE_RECOVERY_SMS_PROVIDER": "${args.recoverySmsProvider}",
                "MAPLE_RECOVERY_SMS_FROM": "${args.recoverySmsFrom}",
                "MAPLE_RECOVERY_SMS_TO": "${args.recoverySmsTo}",
                "MAPLE_RECOVERY_DELIVERY_REQUIRED": "${args.recoveryDeliveryRequired}"
              }
            },
            "addonDependencies": [
              {
                "addonId": "${refs.postgres.id}",
                "keys": [
                  {
                    "keyName": "POSTGRES_URI",
                    "aliases": [
                      "DATABASE_URL",
                      "MAPLE_DATABASE_URL"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "kind": "SecretGroup",
          "spec": {
            "name": "maple-runtime-tls-files",
            "projectId": "${refs.project.id}",
            "type": "secret",
            "secretType": "environment",
            "priority": 60,
            "secrets": {
              "files": {
                "/etc/maple/tls/tls.crt": {
                  "data": "${args.tlsCertBase64}",
                  "encoding": "base64"
                },
                "/etc/maple/tls/tls.key": {
                  "data": "${args.tlsKeyBase64}",
                  "encoding": "base64"
                },
                "/etc/maple/tls/ca.crt": {
                  "data": "${args.tlsCaBase64}",
                  "encoding": "base64"
                }
              }
            }
          }
        },
        {
          "ref": "runtimeBuild",
          "kind": "BuildService",
          "spec": {
            "name": "maple-runtime-image",
            "projectId": "${refs.project.id}",
            "buildSource": "git",
            "billing": {
              "buildPlan": "${args.buildPlan}"
            },
            "vcsData": {
              "projectUrl": "${args.repoUrl}",
              "projectType": "${args.repoProvider}",
              "projectBranch": "${args.repoBranch}"
            },
            "buildSettings": {
              "dockerfile": {
                "dockerFilePath": "/backend/backendA-platform-infra/deploy/Dockerfile",
                "dockerWorkDir": "/"
              }
            }
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "gateway-api",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node backend/backendB-core-services/gateway-api/service/dist/main.js"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 8443,
                "public": true,
                "protocol": "HTTP"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "context-wall",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node backend/backendB-core-services/context-wall/service/dist/main.js"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 9000,
                "public": false,
                "protocol": "HTTP/2"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "mcp-proxy",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node backend/backendB-core-services/mcp-proxy/service/dist/main.js"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 9200,
                "public": false,
                "protocol": "HTTP/2"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "cyber-proxy",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node backend/backendB-core-services/cyber-proxy/service/dist/main.js"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 8080,
                "public": false,
                "protocol": "HTTP/2"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "audit-writer",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node backend/backendB-core-services/audit-writer/service/dist/main.js"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 9400,
                "public": false,
                "protocol": "HTTP/2"
              },
              {
                "name": "p02",
                "internalPort": 9401,
                "public": false,
                "protocol": "HTTP"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "openclaw-gateway",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "external": {
                "imagePath": "ghcr.io/openclaw/openclaw:latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node openclaw.mjs --dev gateway run --port 19001 --bind lan --allow-unconfigured --verbose"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 19001,
                "public": false,
                "protocol": "HTTP"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "openclaw-bridge",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node backend/backendA-platform-infra/scripts/openclaw-bridge-hardcoded.mjs"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 8787,
                "public": false,
                "protocol": "HTTP"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "frontend-a-it-console",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "npm --prefix frontend/frontendA-it-console/template-runtime run dev -- --hostname 0.0.0.0 --port 8080"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 8080,
                "public": true,
                "protocol": "HTTP"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "frontend-b-desktop-app",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "npm --prefix frontend/frontendB-desktop-app/template-runtime run dev -- --hostname 0.0.0.0 --port 8080"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 8080,
                "public": true,
                "protocol": "HTTP"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "frontend-c-marketing-site",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "npm --prefix frontend/frontendC-marketing-download-site/template-runtime run dev -- --hostname 0.0.0.0 --port 8080"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 8080,
                "public": true,
                "protocol": "HTTP"
              }
            ]
          }
        },
        {
          "kind": "DeploymentService",
          "spec": {
            "name": "frontend-d-mcp-widgets",
            "projectId": "${refs.project.id}",
            "billing": {
              "deploymentPlan": "${args.deploymentPlan}"
            },
            "deployment": {
              "instances": 1,
              "internal": {
                "id": "${refs.runtimeBuild.id}",
                "branch": "${args.repoBranch}",
                "buildSHA": "latest"
              },
              "docker": {
                "configType": "customCommand",
                "customCommand": "node backend/backendA-platform-infra/scripts/static-server.mjs --root /app/frontend/frontendD-mcp-widgets/resources --port 8080 --index index.html --proxy-target https://gateway-api:8443 --proxy-prefix /api --proxy-prefix /sse --proxy-prefix /mcp --proxy-prefix /admin/api --proxy-insecure"
              }
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 8080,
                "public": true,
                "protocol": "HTTP"
              }
            ]
          }
        }
      ]
    }
  }
}
