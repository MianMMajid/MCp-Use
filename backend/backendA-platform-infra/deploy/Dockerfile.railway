## ---- Build stage ----
FROM node:22-slim AS build

WORKDIR /app

ARG OPENCLAW_VERSION=2026.2.21-2

# Install build dependencies for native modules (better-sqlite3, @discordjs/opus)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 make g++ git \
    && rm -rf /var/lib/apt/lists/*

# Install OpenClaw CLI in the build stage (needs native build tools)
RUN git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/" \
    && git config --global --add url."https://github.com/".insteadOf "git@github.com:" \
    && npm install -g "openclaw@${OPENCLAW_VERSION}" \
    && openclaw --version

# Install ALL deps (including devDependencies needed for build)
COPY package.json package-lock.json ./
RUN npm ci

# Cache bust — change this value to force a fresh COPY
ARG CACHE_BUST=3
# Copy source and build
COPY . .

# Ensure workspace package dist/ dirs exist (symlinked packages need recreation)
RUN for pkg in maple-common maple-persistence maple-security; do \
      ln -sfn src "backend/backendB-core-services/shared/packages/${pkg}/dist"; \
    done && \
    echo "Workspace dist check:" && \
    for pkg in maple-risk-engine maple-types maple-proto-ts; do \
      dir="backend/backendB-core-services/shared/packages/${pkg}/dist"; \
      echo "  ${pkg}: $(ls ${dir} 2>/dev/null | wc -l) files"; \
    done

RUN npm run template:install
RUN npm run sync:runtime-assets
RUN npm run build
RUN npm run build:frontendA && npm run build:frontendB && npm run build:frontendC

## ---- Production stage ----
FROM node:22-slim

WORKDIR /app

# Install minimal runtime deps + openssl for TLS cert generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git openssl \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built OpenClaw CLI from build stage
COPY --from=build /usr/local/lib/node_modules/openclaw /usr/local/lib/node_modules/openclaw
COPY --from=build /usr/local/bin/openclaw /usr/local/bin/openclaw

# Copy pre-built application from build stage
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/package-lock.json ./package-lock.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/backend ./backend
COPY --from=build /app/frontend ./frontend
COPY --from=build /app/.mcp.json ./.mcp.json
COPY --from=build /app/README.md ./README.md

# Copy Railway entrypoint
COPY backend/backendA-platform-infra/deploy/railway-entrypoint.sh /app/railway-entrypoint.sh
RUN chmod +x /app/railway-entrypoint.sh

# Create non-root user
RUN groupadd -f -g 1000 maple && (useradd -u 1000 -g 1000 -s /bin/sh -m maple 2>/dev/null || true) \
    && chown -R 1000:1000 /app \
    && mkdir -p /tmp/tls && chown 1000:1000 /tmp/tls

ENV HOST=0.0.0.0

# Railway injects PORT dynamically — the entrypoint maps it to GATEWAY_PORT
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3000) + '/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || exit 1

USER 1000:1000

CMD ["/app/railway-entrypoint.sh"]
