## ---- Build stage ----
FROM node:22-slim AS build

WORKDIR /app

ARG OPENCLAW_VERSION=2026.2.21-2

# Install build dependencies for native modules (better-sqlite3, @discordjs/opus)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 make g++ git \
    && rm -rf /var/lib/apt/lists/*

# Install OpenClaw CLI in the build stage (needs native build tools)
RUN git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/" \
    && git config --global --add url."https://github.com/".insteadOf "git@github.com:" \
    && npm install -g "openclaw@${OPENCLAW_VERSION}" \
    && openclaw --version

# Install ALL deps (including devDependencies needed for build)
COPY package.json package-lock.json ./
RUN npm ci

# Cache bust — change this value to force a fresh COPY
ARG CACHE_BUST=5
# Copy source and build
COPY . .

# Ensure workspace package dist/ dirs exist (symlinked packages need recreation)
RUN for pkg in maple-common maple-persistence maple-security; do \
      ln -sfn src "backend/backendB-core-services/shared/packages/${pkg}/dist"; \
    done && \
    echo "Workspace dist check:" && \
    for pkg in maple-risk-engine maple-types maple-proto-ts; do \
      dir="backend/backendB-core-services/shared/packages/${pkg}/dist"; \
      echo "  ${pkg}: $(ls ${dir} 2>/dev/null | wc -l) files"; \
    done

# Install frontend runtime dependencies explicitly (root command aliases removed).
RUN npm --prefix frontend/frontendA-it-console/template-runtime ci \
    && npm --prefix frontend/frontendB-desktop-app/template-runtime ci \
    && npm --prefix frontend/frontendC-marketing-download-site/template-runtime ci
RUN npm run sync:runtime-assets
RUN npm run build
# Frontend builds are independent — each one succeeds or fails on its own
RUN npm --prefix frontend/frontendA-it-console/template-runtime run build \
    || echo "[WARN] frontendA build failed — skipping"
RUN npm --prefix frontend/frontendB-desktop-app/template-runtime run build \
    || echo "[WARN] frontendB build failed — skipping"
RUN npm --prefix frontend/frontendC-marketing-download-site/template-runtime run build \
    || echo "[WARN] frontendC build failed — skipping"

## ---- Production stage ----
FROM node:22-slim

WORKDIR /app

# Install minimal runtime deps + openssl for TLS cert generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git openssl \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built OpenClaw CLI from build stage.
# Only copy the package dir — NOT the bin symlink. Docker COPY dereferences
# symlinks, which breaks the bin script's import.meta.url path resolution
# for dist/entry.(m)js.  Re-create the symlink via `npm link`.
COPY --from=build /usr/local/lib/node_modules/openclaw /usr/local/lib/node_modules/openclaw
RUN set -e; \
    BIN_ENTRY=$(node -p " \
      const p=JSON.parse(require('fs').readFileSync('/usr/local/lib/node_modules/openclaw/package.json','utf8')); \
      typeof p.bin==='string'?p.bin:(p.bin&&p.bin.openclaw)||''"); \
    if [ -n "$BIN_ENTRY" ]; then \
      ln -sf "/usr/local/lib/node_modules/openclaw/$BIN_ENTRY" /usr/local/bin/openclaw; \
    else \
      cd /usr/local/lib/node_modules/openclaw && npm link; \
    fi; \
    chmod +x /usr/local/bin/openclaw; \
    echo "openclaw bin: $(ls -la /usr/local/bin/openclaw)"; \
    openclaw --version

# Copy pre-built application from build stage
COPY --from=build --chown=1000:1000 /app/package.json ./package.json
COPY --from=build --chown=1000:1000 /app/package-lock.json ./package-lock.json
COPY --from=build --chown=1000:1000 /app/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /app/backend ./backend
COPY --from=build --chown=1000:1000 /app/frontend ./frontend
COPY --from=build --chown=1000:1000 /app/.mcp.json ./.mcp.json
COPY --from=build --chown=1000:1000 /app/README.md ./README.md
# mcp-use looks for built widget artifacts under /app/dist in production.
# Copy monolith dist if the build produced it; otherwise create an empty dir
# so gateway startup does not crash looking for widget assets.
RUN --mount=from=build,source=/app/backend,target=/tmp/backend-snap \
    if [ -d /tmp/backend-snap/backendB-core-services/maple-monolith/dist ]; then \
      cp -a /tmp/backend-snap/backendB-core-services/maple-monolith/dist ./dist; \
    else \
      mkdir -p ./dist; \
    fi && chown -R 1000:1000 ./dist

# Copy Railway entrypoint
COPY backend/backendA-platform-infra/deploy/railway-entrypoint.sh /app/railway-entrypoint.sh
RUN chmod +x /app/railway-entrypoint.sh

# Create non-root user
RUN groupadd -f -g 1000 maple && (useradd -u 1000 -g 1000 -s /bin/sh -m maple 2>/dev/null || true) \
    && mkdir -p /tmp/tls && chown 1000:1000 /tmp/tls \
    && mkdir -p /app/.maple-security/quarantine && chown 1000:1000 /app/.maple-security/quarantine

ENV HOST=0.0.0.0

# Railway injects PORT dynamically — the entrypoint maps it to GATEWAY_PORT
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3000) + '/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || exit 1

USER 1000:1000

CMD ["/app/railway-entrypoint.sh"]
