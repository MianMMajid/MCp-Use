{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/backendA-platform-infra/deploy/Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "/app/railway-entrypoint.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
