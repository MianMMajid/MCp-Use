# Required: Gateway API origin for server-side API proxying
MAPLE_GATEWAY_ORIGIN=http://127.0.0.1:3000

# Optional: Admin console origin (defaults to gateway origin)
# MAPLE_ADMIN_CONSOLE_ORIGIN=http://127.0.0.1:4001

# Runtime (set by adapter-node, override if needed)
# PORT=3000
# HOST=127.0.0.1

# Required in production behind reverse proxy (CSRF origin check)
# ORIGIN=https://console.example.com
