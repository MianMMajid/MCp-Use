{
  "name": "frontendA-it-console-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev --host 0.0.0.0",
    "dev:warm": "vite dev --host 0.0.0.0 --port 4101",
    "build": "svelte-kit sync && npm run check:route-conflicts && npm run check:parity && vite build",
    "start": "vite preview",
    "check": "svelte-kit sync && vite build --mode check",
    "lint": "npm run check && npm run check:route-conflicts && npm run check:parity",
    "check:route-conflicts": "node scripts/check-route-conflicts.mjs",
    "check:parity": "node ../../../scripts/check-frontendA-cli-parity.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:cyber-ui": "node --test tests/cyber-view-model.test.mjs",
    "test:e2e": "npm run build"
  },
  "dependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.15.0",
    "clsx": "^2.1.1",
    "mdsvex": "^0.12.6",
    "remark-gfm": "^4.0.1",
    "svelte": "^5.16.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "vite": "^6.2.7"
  }
}
