{
  "name": "mayple-frontend-b",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev --port 3000",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --port 3000",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "npm run check:ui-import-guards",
    "check:surface": "node scripts/check-orchestration-surface.js",
    "check:ui-import-guards": "node scripts/check-ui-import-guards.js"
  },
  "dependencies": {
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/kit": "^2.48.5",
    "@xyflow/svelte": "^1.5.1",
    "clsx": "^2.1.1",
    "svelte": "^5.43.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@typescript-eslint/types": "^8.56.1",
    "postcss": "^8.5.8",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  }
}
